rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School settings & profile
    match /settings/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Digital Mading posts & interactions
    match /mading_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Students database & graduation records
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Staff accounts (Guru & Admin credentials)
    match /staff_accounts/{staffId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Fallback rule for applet documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
